<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MapEditor</AssemblyName>
    <RootNamespace>Echoes.MapEditor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <DefaultItemExcludes>$(DefaultItemExcludes);runtime\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile
      Include="..\AudioEventManager\AudioEventEditorForm.cs"
      Link="AudioEventEditorForm.cs" />
    <Compile
      Include="..\AudioEventManager\BgmConfigEditorControl.cs"
      Link="BgmConfigEditorControl.cs" />
  </ItemGroup>
</Project>
