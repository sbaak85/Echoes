<Window x:Class="ImageView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImageView"
        WindowStyle="None" ResizeMode="CanResize" AllowDrop="True"
        MinWidth="240" MinHeight="160"
        Background="#1C1C1C"
        FontFamily="Segoe UI, Microsoft JhengHei UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Tb" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#40FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#70FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TbText" TargetType="Button" BasedOn="{StaticResource Tb}">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft JhengHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style x:Key="TbClose" TargetType="Button" BasedOn="{StaticResource Tb}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TbSep" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="6,11" />
            <Setter Property="Fill" Value="#50FFFFFF" />
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="#5A5A5A" BorderThickness="1">
        <Grid x:Name="Root" ClipToBounds="True" MouseRightButtonUp="Root_MouseRightButtonUp">

            <!-- Image stage: receives all mouse input that is not on the toolbar -->
            <Canvas x:Name="Stage" Background="#1C1C1C"
                    MouseLeftButtonDown="Stage_MouseLeftButtonDown"
                    MouseMove="Stage_MouseMove"
                    MouseLeftButtonUp="Stage_MouseLeftButtonUp"
                    LostMouseCapture="Stage_LostMouseCapture">
                <Image x:Name="Img" Stretch="Fill" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False" />
            </Canvas>

            <TextBlock x:Name="MessageText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="40" FontSize="16"
                       Foreground="#9A9A9A" IsHitTestVisible="False" />

            <!-- File name, bottom center, fades out after 3 s -->
            <Border x:Name="NameOsd" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="20,0,20,28" Padding="16,6" CornerRadius="6" Background="#8C000000"
                    Opacity="0" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.7" Color="Black" />
                </Border.Effect>
                <TextBlock x:Name="NameText" Foreground="White" FontSize="15" TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- Short hints (zoom %, sort changed, wrapped around...) -->
            <Border x:Name="ToastBox" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,64,0,0" Padding="18,8" CornerRadius="8" Background="#B0000000"
                    Opacity="0" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Foreground="White" FontSize="16" />
            </Border>

            <!-- Toolbar: overlays the image, 50% translucent, slides down from the top -->
            <Grid x:Name="Toolbar" VerticalAlignment="Top" Height="44" Background="#80000000"
                  Visibility="Collapsed"
                  MouseMove="Toolbar_Activity" PreviewMouseDown="Toolbar_Activity" MouseLeave="Toolbar_Activity"
                  MouseLeftButtonDown="Toolbar_MouseLeftButtonDown">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ToolbarShift" Y="-44" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4,0">
                    <Button Style="{StaticResource Tb}" Content="&#xE76B;" ToolTip="上一張（← / 滾輪上）" Click="BtnPrev" />
                    <Button Style="{StaticResource Tb}" Content="&#xE76C;" ToolTip="下一張（→ / 滾輪下）" Click="BtnNext" />
                    <Rectangle Style="{StaticResource TbSep}" />
                    <Button Style="{StaticResource Tb}" Content="&#xE71F;" ToolTip="縮小 10%（小鍵盤 -）" Click="BtnZoomOut" />
                    <Button Style="{StaticResource Tb}" Content="&#xE8A3;" ToolTip="放大 10%（小鍵盤 +）" Click="BtnZoomIn" />
                    <Button Style="{StaticResource TbText}" Content="1:1" ToolTip="還原圖片大小（原始尺寸）" Click="BtnActual" />
                    <Button Style="{StaticResource TbText}" Content="符合高" ToolTip="圖片符合視窗高度" Click="BtnFitHeight" />
                    <Button Style="{StaticResource TbText}" Content="符合寬" ToolTip="圖片符合視窗寬度" Click="BtnFitWidth" />
                    <Rectangle Style="{StaticResource TbSep}" />
                    <Button Style="{StaticResource Tb}" Content="&#xE7AD;" ToolTip="逆時鐘旋轉 90°（小鍵盤 3）" Click="BtnRotateLeft"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </Button.RenderTransform>
                    </Button>
                    <Button Style="{StaticResource Tb}" Content="&#xE7AD;" ToolTip="順時鐘旋轉 90°（小鍵盤 1）" Click="BtnRotateRight" />
                    <Button Style="{StaticResource Tb}" Content="&#xE72C;" ToolTip="重設所有調整（小鍵盤 5）" Click="BtnReset" />
                </StackPanel>

                <TextBlock x:Name="InfoText" Grid.Column="1" Foreground="White" FontSize="13"
                           VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0">
                    <Button x:Name="SortButton" Style="{StaticResource TbText}" Content="排序" ToolTip="瀏覽排序依據" Click="BtnSort" />
                    <Button Style="{StaticResource Tb}" Content="&#xE8C8;" ToolTip="複製圖片（Ctrl+C）" Click="BtnCopy" />
                    <Button Style="{StaticResource Tb}" Content="&#xE838;" ToolTip="在檔案總管中顯示" Click="BtnReveal" />
                    <Button Style="{StaticResource Tb}" Content="&#xE74D;" ToolTip="移到資源回收筒（Delete）" Click="BtnDelete" />
                    <Rectangle Style="{StaticResource TbSep}" />
                    <Button x:Name="FullscreenButton" Style="{StaticResource Tb}" Content="&#xE740;" ToolTip="全螢幕（F11 / 雙擊）" Click="BtnFullscreen" />
                    <Button Style="{StaticResource Tb}" Content="&#xE921;" ToolTip="最小化" Click="BtnMinimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource Tb}" Content="&#xE922;" ToolTip="最大化 / 還原視窗" Click="BtnMaximize" />
                    <Button Style="{StaticResource TbClose}" Content="&#xE8BB;" ToolTip="關閉（Esc）" Click="BtnClose" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
